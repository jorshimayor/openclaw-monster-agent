NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=gsk-your-groq-api-key-here

# Google AI / Gemini — REMOVED (no billing setup). Leave commented if you want to re-enable later.
# To re-add: create google_gemini provider, add "google_gemini" to LLM_FALLBACK_ORDER, add models.
# GOOGLE_API_KEY=AIza-your-google-ai-studio-api-key-here

GITHUB_TOKEN=ghp-your-github-personal-access-token-here

NOTION_TOKEN=secret-your-notion-integration-token-here
NOTION_DB_ID=your-notion-knowledge-base-database-id

# Slack — pick ONE of the tokens below (Bot Token preferred). Both xoxb- and xoxp- are supported.
# If both are set, SLACK_BOT_TOKEN wins (bot acts as its own user; needs channel invite).
# SLACK_BOT_TOKEN  — starts with xoxb-  (Bot User OAuth Token, app-level, needs bot scopes chat:write, channels:read)
# SLACK_USER_TOKEN — starts with xoxp-  (User OAuth Token, acts as your user, e.g. for DM reads / user-level list_channels)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_USER_TOKEN=xoxp-your-slack-user-token-here  # optional
SLACK_CHANNEL=#agent-updates

GOOGLE_WORKSPACE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_WORKSPACE_CLIENT_SECRET=your-google-oauth-client-secret

HASHNODE_TOKEN=your-hashnode-personal-access-token-here
HASHNODE_PUBLICATION_ID=your-hashnode-publication-id

LLM_FALLBACK_ORDER=["nvidia_nim","groq"]

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-frontend.vercel.app"]

LOG_LEVEL=INFO
