NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=gsk-your-groq-api-key-here

# Google AI / Gemini — REMOVED (no billing setup). Leave commented if you want to re-enable later.
# To re-add: create google_gemini provider, add "google_gemini" to LLM_FALLBACK_ORDER, add models.
# GOOGLE_API_KEY=AIza-your-google-ai-studio-api-key-here

GITHUB_TOKEN=ghp-your-github-personal-access-token-here

NOTION_TOKEN=secret-your-notion-integration-token-here
NOTION_DB_ID=your-notion-knowledge-base-database-id

# Slack — pick ONE of the tokens below (Bot Token preferred). Both xoxb- and xoxp- are supported.
# If both are set, SLACK_BOT_TOKEN wins (bot acts as its own user; needs channel invite).
# SLACK_BOT_TOKEN  — starts with xoxb-  (Bot User OAuth Token, app-level, needs bot scopes chat:write, channels:read)
# SLACK_USER_TOKEN — starts with xoxp-  (User OAuth Token, acts as your user, e.g. for DM reads / user-level list_channels)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_USER_TOKEN=xoxp-your-slack-user-token-here  # optional
SLACK_CHANNEL=#agent-updates

# Google Workspace — OAuth 2.0 "Desktop" or "Web" credentials from https://console.cloud.google.com/
# Required scopes:
#   https://www.googleapis.com/auth/calendar             — read/write Calendar events
#   https://www.googleapis.com/auth/documents            — read/write Docs
#   https://www.googleapis.com/auth/spreadsheets         — read/write Sheets
#   https://www.googleapis.com/auth/drive.file           — create files in Drive
#   https://www.googleapis.com/auth/gmail.send           — send email via Gmail
#   https://www.googleapis.com/auth/gmail.readonly       — read email list/threads
# To generate GOOGLE_WORKSPACE_REFRESH_TOKEN:
#   1. Create OAuth consent screen + OAuth 2.0 Client at console.cloud.google.com
#   2. Run: python -c "
#        from google_auth_oauthlib.flow import InstalledAppFlow
#        SCOPES=['https://www.googleapis.com/auth/calendar','https://www.googleapis.com/auth/documents','https://www.googleapis.com/auth/spreadsheets','https://www.googleapis.com/auth/drive.file','https://www.googleapis.com/auth/gmail.send','https://www.googleapis.com/auth/gmail.readonly']
#        flow = InstalledAppFlow.from_client_secrets_file('client_secret.json', SCOPES)
#        creds = flow.run_local_server(port=0)
#        print('REFRESH_TOKEN:', creds.refresh_token)
#      "
GOOGLE_WORKSPACE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_WORKSPACE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_WORKSPACE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_WORKSPACE_SUBJECT_EMAIL=you@yourdomain.com

# Neon Postgres — create via: `npx neonctl@latest auth login` then `npx neonctl@latest projects create monster-agent`
# Or grab the pooled connection string from https://console.neon.tech/  (looks like postgres://user:pass@hostname-1.region.neon.tech:5432/neondb?sslmode=require&options=endpoint%3Dep-xyz)
DATABASE_URL=postgresql+asyncpg://user:password@hostname.region.neon.tech:5432/neondb?sslmode=require

# ⚠️  RETIRED 2026-08-23: Hashnode API requires Pro. Fields kept for back-compat only;
# server is NOT launched at runtime. Leave these blank.
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=

# Telegram — Personal Assistant Agent notifications (the ONLY outbound channel for task/integration updates)
# Obtain TELEGRAM_BOT_TOKEN:  open https://t.me/BotFather  → /newbot → copy token (format: 1234567890:ABCdef...)
# Obtain TELEGRAM_CHAT_ID:   after creating bot, open bot URL → click START → send "hi" →
#                            visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy result[0].message.chat.id
# TELEGRAM_ADMIN_IDS:        comma-separated Telegram user IDs that are allowed to run /mute, /unmute, /digest commands
#                            (usually just your own chat id; e.g. "123456789" or "123456789,987654321")
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHijKLmnoPQRstUVwxyz0123456789
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_IDS=123456789

LLM_FALLBACK_ORDER=["nvidia_nim","groq"]

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-frontend.vercel.app","https://your-frontend.pages.dev"]

LOG_LEVEL=INFO
