# Force npm peer dependency resolution mode.
# Cloudflare next-on-pages runs `vercel build` which calls `npm install` internally;
# this avoids the peer dep pinning conflict for `next` (we're on 15.5.23, @cloudflare/next-on-pages
# peer pin allows <= 15.5.2 — runtime behaviour is identical so legacy-peer-deps is safe).
legacy-peer-deps=true
