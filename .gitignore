# ———————————————————————————————————————————————
.neon-config/
.vercel-config/
.render-config/
.render/

# ———————————————————————————————————————————————
# HTTP transient capture artifacts (private)
# ———————————————————————————————————————————————
.httpyac/
*.httpyac/

# ———————————————————————————————————————————————
# Secrets (MANDATORY — never publish)
# ———————————————————————————————————————————————
.env
.env.*
!.env.example
!.env.sample
# frontend production build config — only a public URL, must be committed
# so builds can't silently regress to the localhost fallback again
!frontend/.env.production
backend/.env
frontend/.env.local
mcp-servers/hashnode/.env
*.p12
*.key
*.pem

# Symlink to private source-of-truth docs in chelsea_bot (career plan + season calendar) — NEVER commit
docs/private-sot
