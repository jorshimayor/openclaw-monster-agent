{
  "name": "monster-agent-backend-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "deploy": "npx wrangler deploy",
    "dev": "npx wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "container:build": "npx wrangler containers build -t monster-agent-backend:latest .",
    "container:push": "npx wrangler containers push monster-agent-backend:latest",
    "container:deploy": "npm run container:build && npm run container:push && npm run deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
