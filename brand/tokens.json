{
  "_note": "Read off the two banner designs by eye, then regularised. Hues and relationships are faithful; exact hex values are a judgement call and worth checking against the source files if you still have them.",
  "color": {
    "ink":        { "900": "#05070F", "800": "#080B18", "700": "#0C1124", "600": "#121933" },
    "depth":      { "_note": "the glow that lifts the lower third of the banner",
                    "900": "#101A4D", "700": "#1B2A7A", "500": "#2A3FA8" },
    "accent":     { "_note": "the key-name blue — primary brand colour",
                    "600": "#2F49E8", "500": "#3D5AFE", "400": "#5B74FF" },
    "periwinkle": { "_note": "second half of each key, and the softer highlights",
                    "400": "#8B9BFF", "300": "#A5B2FF" },
    "paper":      { "100": "#FFFFFF", "200": "#E8ECF7" },
    "muted":      { "_note": "the greyed `true` — present but receding",
                    "500": "#6E7893", "400": "#8A93AB" },
    "line":       { "_note": "circuit traces and dashed frames",
                    "strong": "rgba(93,120,255,0.55)", "soft": "rgba(93,120,255,0.22)" },
    "grid":       { "_note": "the dot matrix", "dot": "rgba(255,255,255,0.045)" }
  },
  "type": {
    "mono": "'JetBrains Mono', 'SF Mono', 'Menlo', 'Consolas', monospace",
    "sans": "'Inter', -apple-system, 'Segoe UI', system-ui, sans-serif",
    "_note": "The banners set key names in a heavy sans and the code scaffolding in mono. The frontend already loads both.",
    "weight": { "code": 400, "key": 700 },
    "tracking": { "code": "0.02em", "key": "-0.01em", "label": "0.18em" }
  },
  "radius": { "sm": "4px", "md": "8px", "lg": "14px", "pill": "999px" },
  "canvas": {
    "x_banner":        { "w": 1500, "h": 500 },
    "linkedin_banner": { "w": 1584, "h": 396 },
    "youtube_thumb":   { "w": 1280, "h": 720 },
    "article_header":  { "w": 1200, "h": 630 },
    "newsletter":      { "w": 1200, "h": 400 }
  }
}
